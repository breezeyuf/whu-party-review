{$PARTY_REVIEW_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
    }
    reverse_proxy backend:8000 {
        header_up X-Forwarded-For {remote_host}
    }
}

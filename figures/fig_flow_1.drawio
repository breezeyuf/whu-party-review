<diagram name="提交包五级审核与整改闭环流程" id="fig_flow_1">
<mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="440" pageHeight="560" background="none" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="p1" value="学生（或支部代传）上传本阶段材料" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F3EE;strokeColor=#59638F;strokeWidth=1.6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86.4" y="9.0" width="144.0" height="27.0" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;后台文档解析与 AI 四类校验&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#3A3A3A;&quot;&gt;生成 AI 自查报告与标准化修改建议&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#59638F;strokeWidth=1.6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86.4" y="50.4" width="144.0" height="36.0" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;存在阻断级问题？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F3EE;strokeColor=#59638F;strokeWidth=1.6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95.4" y="100.8" width="126.0" height="54.0" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;学生逐条整改&lt;/b&gt;&lt;br&gt;或填写情况说明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4E3A;strokeWidth=1.6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="5.4" y="93.6" width="86.4" height="46.8" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;学生提交&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#3A3A3A;&quot;&gt;冻结材料版本，round_no 不变&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#59638F;strokeWidth=1.6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86.4" y="169.2" width="144.0" height="36.0" as="geometry"/></mxCell>
<mxCell id="p6" value="&lt;b&gt;当前层级审核&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#3A3A3A;&quot;&gt;支部初审 → 交叉互查&lt;br&gt;→ 学院复审 → 组织部备案&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF2;strokeColor=#59638F;strokeWidth=2.2;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86.4" y="219.6" width="144.0" height="46.8" as="geometry"/></mxCell>
<mxCell id="p7" value="&lt;b&gt;本层审核结论&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F3EE;strokeColor=#59638F;strokeWidth=1.6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95.4" y="280.8" width="126.0" height="54.0" as="geometry"/></mxCell>
<mxCell id="p8" value="&lt;b&gt;还有下一审核层级？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F3EE;strokeColor=#59638F;strokeWidth=1.6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="86.4" y="352.8" width="144.0" height="59.4" as="geometry"/></mxCell>
<mxCell id="p9" value="&lt;b&gt;备案归档&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#3A3A3A;&quot;&gt;提交包只读，节点锁定&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#59638F;strokeWidth=1.6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="86.4" y="428.4" width="144.0" height="36.0" as="geometry"/></mxCell>
<mxCell id="p10" value="&lt;b&gt;生成整改通知并推送&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#3A3A3A;&quot;&gt;按已确认问题 + 修改建议&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4E3A;strokeWidth=1.6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="262.8" y="270.0" width="135.0" height="46.8" as="geometry"/></mxCell>
<mxCell id="p11" value="&lt;b&gt;学生逐条回复整改&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#3A3A3A;&quot;&gt;上传新版本 或 填写情况说明&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4E3A;strokeWidth=1.6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="262.8" y="331.2" width="135.0" height="46.8" as="geometry"/></mxCell>
<mxCell id="p12" value="&lt;b&gt;重新提交&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#3A3A3A;&quot;&gt;自动重跑 AI 复核&lt;br&gt;比对已解决 / 未解决 / 新增&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4E3A;strokeWidth=1.6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="262.8" y="392.4" width="135.0" height="52.2" as="geometry"/></mxCell>

# Copy to .env.server; keep it private. PUBLIC_BASE_URL must match the browser URL.
PARTY_REVIEW_DOMAIN=review.example.edu
PUBLIC_BASE_URL=https://review.example.edu
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Use the SAME database password as above, URL-encoded for a connection URI.
DATABASE_URL=postgresql+psycopg://party_review:replace-with-a-long-random-password@db:5432/party_review
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
HTTP_PORT=80
HTTPS_PORT=443
CADDY_CONFIG=Caddyfile.public

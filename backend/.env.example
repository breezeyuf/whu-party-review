# Copy to backend/.env and replace the database password.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/party_review
HOST=127.0.0.1
PORT=8000
# Leave blank to generate and print a random first-login password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Leave blank to persist a generated key in storage/.secret.
APP_SECRET_KEY=
WORKER_ENABLED=1
DEMO_LOGIN_HINT=0
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Empty means forwarding headers are ignored. Set only your actual proxy peers.
TRUSTED_PROXY_CIDRS=
# Hard cap on the complete HTTP body, before multipart parsing (including overhead).
MAX_REQUEST_BODY_MB=512


<mxCell id="T_orgs" value="&lt;b&gt;orgs 组织架构&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;parent_id &lt;b&gt;FK&lt;/b&gt;→orgs&lt;br&gt;（自关联：学校—学院—支部）&lt;br&gt;name / org_type&lt;br&gt;code / is_demo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F7C78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="16" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_users" value="&lt;b&gt;users 用户账号&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;org_id &lt;b&gt;FK&lt;/b&gt;→orgs&lt;br&gt;username / real_name / password_hash&lt;br&gt;status / must_change_password&lt;br&gt;failed_login_count / locked_until&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F7C78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="140" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_user_roles" value="&lt;b&gt;user_roles 角色授权&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;user_id &lt;b&gt;FK&lt;/b&gt;→users&lt;br&gt;org_id &lt;b&gt;FK&lt;/b&gt;→orgs（角色作用范围）&lt;br&gt;role（STUDENT/BRANCH/CROSS/&lt;br&gt;COLLEGE/ORG/SYS）&lt;br&gt;is_active&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F7C78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="264" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_batches" value="&lt;b&gt;batches 发展批次&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;name / year / term&lt;br&gt;stage_code &lt;b&gt;FK&lt;/b&gt;→stages&lt;br&gt;start_date / end_date&lt;br&gt;branch_deadline / college_deadline&lt;br&gt;org_deadline&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F7C78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="388" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_cross" value="&lt;b&gt;cross_review_pairs 互查配对&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;batch_id &lt;b&gt;FK&lt;/b&gt;→batches&lt;br&gt;reviewer_branch_id &lt;b&gt;FK&lt;/b&gt;→orgs&lt;br&gt;target_branch_id &lt;b&gt;FK&lt;/b&gt;→orgs（须不同支部）&lt;br&gt;reviewer_user_id &lt;b&gt;FK&lt;/b&gt;→users&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F7C78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="512" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_audit" value="&lt;b&gt;audit_logs 审计日志&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;actor_user_id &lt;b&gt;FK&lt;/b&gt;→users&lt;br&gt;action / object_type / object_id&lt;br&gt;detail JSONB / ip / created_at&lt;br&gt;（触发器禁止 UPDATE / DELETE）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F7C78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="636" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_archives" value="&lt;b&gt;archives 发展档案（一人一档）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;student_user_id &lt;b&gt;FK&lt;/b&gt;→users（UNIQUE）&lt;br&gt;college_id / branch_id &lt;b&gt;FK&lt;/b&gt;→orgs&lt;br&gt;batch_id &lt;b&gt;FK&lt;/b&gt;→batches&lt;br&gt;current_stage &lt;b&gt;FK&lt;/b&gt;→stages&lt;br&gt;anon_code / data_source / is_demo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#40566F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="760" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_submissions" value="&lt;b&gt;submissions 提交包&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;archive_id &lt;b&gt;FK&lt;/b&gt;→archives&lt;br&gt;（阶段内 UNIQUE）&lt;br&gt;stage_code &lt;b&gt;FK&lt;/b&gt;→stages / status&lt;br&gt;return_level / round_no / ai_status&lt;br&gt;latest_report_id &lt;b&gt;FK&lt;/b&gt;→ai_reports / filed_at&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#40566F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="884" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_materials" value="&lt;b&gt;materials 材料&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;submission_id &lt;b&gt;FK&lt;/b&gt;→submissions&lt;br&gt;type_id &lt;b&gt;FK&lt;/b&gt;→material_types&lt;br&gt;current_version_id &lt;b&gt;FK&lt;/b&gt;→material_versions&lt;br&gt;type_source / type_confidence / type_status&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#40566F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="1008" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_mv" value="&lt;b&gt;material_versions 材料版本&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;material_id &lt;b&gt;FK&lt;/b&gt;→materials&lt;br&gt;（version_no 唯一）&lt;br&gt;stored_path / file_ext / file_size / sha256&lt;br&gt;parse_status / is_frozen&lt;br&gt;（触发器禁止 DELETE）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#40566F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="1132" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_parse" value="&lt;b&gt;parse_results 解析结果（1:1）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;version_id &lt;b&gt;FK&lt;/b&gt;→material_versions&lt;br&gt;（UNIQUE）&lt;br&gt;parser（PDF_TEXT/DOCX/OCR/MIXED）&lt;br&gt;full_text / pages JSONB（文字块与坐标）&lt;br&gt;visual_marks JSONB（印章、签名）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#40566F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="1256" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_tnd" value="&lt;b&gt;time_node_defs 时间节点定义&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;code &lt;b&gt;PK&lt;/b&gt;（T01–T21）&lt;br&gt;node_name / stage_code / value_kind&lt;br&gt;extract_keywords（抽取关键词）&lt;br&gt;is_sequence（序列型节点：思想汇报/考察记录）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#745F78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="1380" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_tne" value="&lt;b&gt;time_node_extractions 节点抽取&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;archive_id &lt;b&gt;FK&lt;/b&gt;→archives&lt;br&gt;version_id &lt;b&gt;FK&lt;/b&gt;→material_versions&lt;br&gt;node_code &lt;b&gt;FK&lt;/b&gt;→time_node_defs&lt;br&gt;value_date / snippet / page_no&lt;br&gt;confidence / method&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#745F78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="1504" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_atn" value="&lt;b&gt;archive_time_nodes 档案节点值&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;archive_id &lt;b&gt;FK&lt;/b&gt;→archives（节点唯一）&lt;br&gt;node_code &lt;b&gt;FK&lt;/b&gt;→time_node_defs&lt;br&gt;value_date / value_end_date / value_hours&lt;br&gt;is_current / has_conflict&lt;br&gt;corrected_by / locked&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#745F78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="1628" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_reports" value="&lt;b&gt;ai_reports AI 审核报告&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;submission_id &lt;b&gt;FK&lt;/b&gt;→submissions&lt;br&gt;rule_version_id &lt;b&gt;FK&lt;/b&gt;→rule_versions&lt;br&gt;mode（RULE_ONLY/HYBRID）/ recommendation&lt;br&gt;handover_status&lt;br&gt;effective_recommendation&lt;br&gt;trigger_type / recheck_summary JSONB&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#745F78;strokeWidth=2.2;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="1752" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_issues" value="&lt;b&gt;issues 问题清单&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;report_id &lt;b&gt;FK&lt;/b&gt;→ai_reports&lt;br&gt;material_id &lt;b&gt;FK&lt;/b&gt;→materials&lt;br&gt;category / severity / rule_code&lt;br&gt;fingerprint&lt;br&gt;status / resolution&lt;br&gt;needs_human_judgement&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#745F78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="1876" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_notices" value="&lt;b&gt;notices 补全与整改通知&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;submission_id &lt;b&gt;FK&lt;/b&gt;→submissions&lt;br&gt;notice_type（COMPLETION/RECTIFICATION）&lt;br&gt;content JSONB / deadline / sent_at / exported&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#745F78;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="2000" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_mtypes" value="&lt;b&gt;material_types 材料类型&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;name / stage_code / is_required&lt;br&gt;title_keywords / exclude_keywords&lt;br&gt;date_node_map JSONB&lt;br&gt;element_template JSONB&lt;br&gt;format_requirements JSONB&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#59638F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="2124" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_checklist" value="&lt;b&gt;checklist_items 阶段材料清单&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;stage_code &lt;b&gt;FK&lt;/b&gt;→stages&lt;br&gt;type_id &lt;b&gt;FK&lt;/b&gt;→material_types&lt;br&gt;count_mode（FIXED/PER_PERIOD）&lt;br&gt;fixed_count&lt;br&gt;period_months / period_start_node&lt;br&gt;is_required&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#59638F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="2248" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_rv" value="&lt;b&gt;rule_versions 规则版本快照&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;version_no（递增）/ snapshot JSONB&lt;br&gt;change_summary / created_by &lt;b&gt;FK&lt;/b&gt;→users&lt;br&gt;（时间规则 / 形式内容规则 /&lt;br&gt;术语库 / 建议模板&lt;br&gt;任何改动在同一事务内追加一行）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#59638F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="2372" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_rr" value="&lt;b&gt;review_records 审核留痕&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;submission_id &lt;b&gt;FK&lt;/b&gt;→submissions&lt;br&gt;level / action&lt;br&gt;reviewer_user_id &lt;b&gt;FK&lt;/b&gt;→users&lt;br&gt;report_id &lt;b&gt;FK&lt;/b&gt;→ai_reports / round_no&lt;br&gt;comment / is_batch / created_at（禁止改删）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#59638F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="2496" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_jobs" value="&lt;b&gt;jobs 后台任务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;job_type（PARSE/AI_CHECK/&lt;br&gt;BATCH_AI_CHECK/BATCH_UPLOAD/&lt;br&gt;NOTICE_BATCH/EXPORT）&lt;br&gt;status / ref_id / parent_job_id &lt;b&gt;FK&lt;/b&gt;→jobs&lt;br&gt;attempts / heartbeat_at / error_message&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#59638F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="2620" width="300" height="116" as="geometry"/></mxCell>
<mxCell id="T_messages" value="&lt;b&gt;messages 站内消息&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;id &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;user_id &lt;b&gt;FK&lt;/b&gt;→users&lt;br&gt;msg_type / title / body&lt;br&gt;link_type / link_id / dedup_key&lt;br&gt;is_read / created_at&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#59638F;strokeWidth=1.6;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="16" y="2744" width="300" height="116" as="geometry"/></mxCell>
